# AI API keys (at least one required for Buddie AI)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Hugging Face API key (for emotion detection)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Azure OpenAI Configuration (optional - use when deployed on Azure)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_KEY=your_azure_openai_api_key

# AI Model Configuration
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.1-70b-versatile
GEMINI_MODEL=gemini-1.5-flash
MISTRAL_MODEL=mistral-small
DEEPSEEK_MODEL=deepseek-chat
HF_EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base

# Hugging Face Datasets for Buddie training data
BUDDIE_HF_DATASET=onyi666/mydataset2
BUDDIE_HF_CONFIG=default
BUDDIE_COUNSELING_DATASET=mental_health_counseling

# AI Configuration
AI_TIMEOUT_MS=30000
AI_RETRIES=1
BUDDIE_MEMORY_WINDOW=6
BUDDIE_MEMORY_MAX=60
BUDDIE_REPLY_MAX_TOKENS=85
BUDDIE_DIALOG_FEWSHOT_COUNT=2

# Database (Azure Database for PostgreSQL Flexible Server)
DB_HOST=your-server.postgres.database.azure.com
DB_USER=adminuser@your-server
DB_PASSWORD=your_password
DB_NAME=UNITY_WITHIN
DB_PORT=5432
DB_CONNECT_TIMEOUT_MS=10000
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Server
# Note: Azure App Service sets PORT automatically; only set this locally if needed.
# PORT=5000

# CORS — comma-separated list of allowed frontend origins
# For Azure Static Web Apps or custom domain, add them here
ALLOWED_ORIGINS=https://unitywithin.azurewebsites.net

# Path to built frontend static files, relative to the server directory
# Default: dist (matches CI/CD packaging)
STATIC_FILES_PATH=dist
