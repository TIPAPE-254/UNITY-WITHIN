# Database Configuration (MySQL local default)
# Local dev: use mysql.
# Production/Azure: set DB_TYPE=postgres in App Service settings.
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=UNITY_WITHIN
DB_PORT=3306
DB_SSL=false

# Server Configuration
PORT=5000
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key
HUGGINGFACE_API_KEY=your_huggingface_api_key
AI_TIMEOUT_MS=20000
AI_RETRIES=1

# Password Reset
RESET_PASSWORD_BASE_URL=https://www.unitywithin.app

# Brevo SMTP
# Preferred: set BREVO_API_KEY. SMTP settings below are kept as fallback.
BREVO_API_KEY=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
BREVO_FROM_EMAIL=hello@unitywithin.app
BREVO_FROM_NAME=UnityWithin

# Web Push VAPID Keys
VAPID_PUBLIC_KEY="BMk-1beG36Eusi_fOeushnUCdJzV1H7IhNJDbHuQYZ5_CdxctsqtyYiqaaesOckXf8Y_NAAB2t7BYhHbdor8DbI"
